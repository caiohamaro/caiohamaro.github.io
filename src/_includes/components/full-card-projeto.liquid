
<li style="--accent-color:#E24A68" >
        <div class="timeline-card">
			<div class="timeline-card-badge {{feito}}"> 
				<div class="timeline-card-badge-header">
					<div class="timeline-card-badge-year">{{ ano }}</div>
					<div class="timeline-card-badge-type {{feito}}">{{ tipo }}</div>
				</div>
				<img src="{{imagem}}" class="timeline-card-badge-cover {{feito}}">
			</div>
			<div class="timeline-card-content {{feito}}">
				<div class="timeline-card-content-favorite {{destaque}}">{{destaque}}</div>
				<div class="timeline-card-content-name">{{ titulo }}</div>
				<div class="timeline-card-content-author">{{ autor }}</div>
				<div class="timeline-card-content-analisis">{{ analise }}</div>
				<!--<div class="title">{{ titulo }}</div>
        		<div class="descr">{{ autor }}</div>-->
			</div>
		</div>
    </li>
   
